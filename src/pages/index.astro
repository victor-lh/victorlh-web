---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Stack from '../components/sections/Stack.astro';
import Experience from '../components/sections/Experience.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../data/site';

const meta = [
  { label: 'Ubicación', values: ['Madrid, España'] },
  { label: 'Especialidad', values: ['Backend', 'Microservicios', 'Cloud'] },
  { label: 'Stack principal', values: ['Java 17', 'Spring Boot', 'Kubernetes'] },
];
---

<BaseLayout
  title="Víctor Latorre · Backend Engineer"
  description="Backend Engineer especializado en microservicios, arquitecturas distribuidas y ecosistema Java/Spring. Madrid, España."
>
  <Hero />

  <!-- About -->
  <section id="about" class="section">
    <div class="container">
      <h2 class="section-title reveal">Sobre mí</h2>

      <p class="about-lead reveal">
        Soy desarrollador de software especializado en <strong>ingeniería de backend y diseño de
        arquitecturas escalables</strong>. Mi trayectoria se define por una mentalidad de aprendizaje
        continuo y una visión integral del ciclo de vida del software.
      </p>

      <div class="about-grid">
        <div class="about-text reveal">
          <p>He consolidado una sólida experiencia en el ecosistema <strong>Java/Spring</strong>, con foco en
            microservicios, sistemas basados en eventos y migraciones de arquitecturas monolíticas a distribuidas en
            sectores como Fintech, Retail, Seguros y Sector Público.</p>
          <p>Me distingo por un alto sentido de la responsabilidad, capacidad de colaboración en equipos
            multidisciplinares y un enfoque pragmático hacia la resolución de <strong>problemas técnicos
              complejos</strong>.</p>
          <p>Mi proyección está orientada a liderar la innovación tecnológica en arquitecturas cloud y microservicios,
            aportando valor a través de la excelencia técnica en proyectos de alto impacto.</p>
        </div>

        <dl class="about-meta reveal">
          {
            meta.map((item) => (
              <div class="meta-item">
                <dt>{item.label}</dt>
                <dd>
                  <ul>
                    {item.values.map((v) => (
                      <li>{v}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <Stack />
  <Experience />

  <!-- Contact -->
  <section id="contact" class="section contact">
    <div class="container">
      <div class="contact-panel">
        <div class="contact-copy">
          <h2 class="contact-label reveal">Contacto</h2>
          <p class="contact-headline reveal">Puedes <span>encontrarme</span> aquí</p>
          <p class="contact-sub reveal">
            Si tienes alguna pregunta técnica, quieres compartir ideas o simplemente conectar, estaré
            encantado de leerte.
          </p>
        </div>

        <div class="contact-actions reveal">
          <a href={`mailto:${site.email}`} class="contact-email">{site.email}</a>
          <div class="contact-links">
            <Button variant="solid" href={`mailto:${site.email}`} label="Enviar email" />
            <Button variant="outline" href={site.linkedin} label="LinkedIn" external />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* About */
  .about-lead {
    max-width: 40ch;
    margin-top: clamp(2rem, 4vw, 3rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.375rem);
    line-height: 1.25;
    letter-spacing: -.02em;
    color: var(--ink-soft);
  }
  .about-lead strong {
    font-weight: 500;
    color: var(--ink);
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    align-items: start;
  }

  .about-text {
    grid-column: 1 / span 7;
  }
  .about-text p {
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .about-text p + p {
    margin-top: 1.25rem;
  }
  .about-text strong {
    font-weight: 500;
    color: var(--ink);
  }

  .about-meta {
    grid-column: 9 / -1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .meta-item dt {
    margin-bottom: .3rem;
    font-size: .875rem;
    color: var(--ink-soft);
  }
  .meta-item ul {
    list-style: none;
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  /* Contact */
  .contact {
    padding-top: 0;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem;
    align-items: end;
    padding: clamp(2rem, 6vw, 4.5rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .contact-label {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: .8125rem;
    color: var(--ink-soft);
  }

  .contact-headline {
    margin-block: 1rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 1;
    letter-spacing: -.045em;
    text-wrap: balance;
  }
  .contact-headline span {
    color: var(--accent);
  }

  .contact-sub {
    max-width: 44ch;
    font-size: 1.0625rem;
    color: var(--ink-soft);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .contact-email {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    letter-spacing: -.02em;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    box-shadow: inset 0 -1px 0 var(--line);
    transition: background-size .45s var(--ease-out), color .2s ease;
  }
  .contact-email:hover {
    background-size: 100% 2px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }

  @media (max-width: 900px) {
    .about-text,
    .about-meta {
      grid-column: 1 / -1;
    }

    .contact-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
