---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="badge">{label}</span>

<style>
  .badge {
    font-family: 'DM Mono', monospace;
    font-size: .6rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .25rem .6rem;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink-soft);
    display: inline-block;
    width: fit-content;
  }
</style>
