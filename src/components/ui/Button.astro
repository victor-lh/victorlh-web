---
interface Props {
  variant: 'solid' | 'outline' | 'link';
  href: string;
  label: string;
  external?: boolean;
}

const { variant, href, label, external = false } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
const arrow = variant === 'link' ? '→' : external ? '↗' : undefined;
---

<a href={href} {rel} {target} class:list={['btn', `btn--${variant}`]}>
  <span>{label}</span>
  {arrow && <span class="btn-arrow" aria-hidden="true">{arrow}</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: .9375rem;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color .25s ease, color .25s ease, border-color .25s ease,
      transform .2s var(--ease-out);
  }
  .btn:active {
    transform: scale(.98);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform .3s var(--ease-out);
  }
  .btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  .btn--solid {
    padding: 1rem 1.5rem;
    border-radius: var(--radius-full);
    background: var(--ink);
    color: var(--white);
  }
  .btn--solid:hover {
    background: var(--accent);
  }

  .btn--outline {
    padding: calc(1rem - 1px) 1.5rem;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: var(--radius-full);
    color: var(--ink);
  }
  .btn--outline:hover {
    border-color: var(--ink);
    background: var(--white);
  }

  .btn--link {
    padding-block: .5rem;
    color: var(--ink);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-position: 0 calc(100% - .2rem);
    background-repeat: no-repeat;
  }
  .btn--link:hover {
    color: var(--accent);
  }
</style>
