---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="chip">{label}</span>

<style>
  .chip {
    display: inline-block;
    padding: .4rem .65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    font-family: var(--font-mono);
    font-size: .78rem;
    line-height: 1.2;
    color: var(--ink);
    white-space: nowrap;
  }
</style>
