---
interface Props {
  label: string;
  variant?: 'default' | 'blue';
}

const { label, variant = 'default' } = Astro.props;
---

<span class:list={['chip', variant === 'blue' && 'chip--blue']}>{label}</span>

<style>
  .chip {
    font-family: 'DM Mono', monospace;
    font-size: .65rem;
    letter-spacing: .1em;
    padding: .3rem .8rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    display: inline-block;
  }
  .chip--blue {
    border-color: #4a9eff;
    color: #4a9eff;
  }
</style>
