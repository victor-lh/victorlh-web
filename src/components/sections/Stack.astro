---
const skillCards = [
  {
    icon: '◈',
    category: 'Backend',
    name: 'Lenguajes & Frameworks',
    tags: ['Java 17', 'Spring Boot', 'Spring Cloud', 'Kotlin', 'Node.js', 'Python', 'REST', 'SOAP'],
  },
  {
    icon: '⬡',
    category: 'Arquitectura',
    name: 'Diseño de Sistemas',
    tags: ['Microservicios', 'Event-Driven', 'Hexagonal', 'Serverless', 'RabbitMQ', 'GCP Pub/Sub', 'API First', 'WebRTC'],
  },
  {
    icon: '⬟',
    category: 'Infraestructura',
    name: 'DevOps & Cloud',
    tags: ['Docker', 'Kubernetes', 'OpenShift', 'GCP', 'GKE', 'Jenkins', 'CI/CD', 'Git'],
  },
  {
    icon: '◇',
    category: 'Datos',
    name: 'Bases de Datos',
    tags: ['PostgreSQL', 'Oracle DB', 'MongoDB', 'IBM DB2', 'SQL Server', 'Elasticsearch', 'Firebase'],
  },
  {
    icon: '◉',
    category: 'Observabilidad & APIs',
    name: 'Monitoring & Seguridad',
    tags: ['Kibana / ELK', 'WSO2', 'Spring Security', 'Maven', 'OpenAPI', 'GraphQL'],
  },
  {
    icon: '◬',
    category: 'Sectores',
    name: 'Experiencia en industria',
    tags: ['Fintech', 'Seguros', 'E-commerce', 'Mobile', 'Sector público', 'Retail'],
  },
];
---

<section id="skills">
  <div class="inner">
    <div class="section-header">
      <span class="section-num">02</span>
      <h2 class="section-title">Skills</h2>
      <div class="section-line"></div>
    </div>

    <div class="skills-grid reveal">
      {skillCards.map((card) => (
        <div class="skill-card">
          <div class="skill-icon">{card.icon}</div>
          <div class="skill-cat">{card.category}</div>
          <div class="skill-name">{card.name}</div>
          <div class="skill-tags">
            {card.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #skills { background: var(--bg); }

  .inner { max-width: 1000px; margin: 0 auto; }

  section { padding: 7rem 4rem; }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  .section-num {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--accent);
    letter-spacing: .15em;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -.01em;
  }
  .section-line { flex: 1; height: 1px; background: var(--line); }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .skill-card {
    background: var(--bg);
    padding: 2rem;
    transition: background .2s;
  }
  .skill-card:hover { background: var(--white); }

  .skill-icon { font-size: 1.2rem; margin-bottom: .8rem; }

  .skill-cat {
    font-family: var(--font-mono);
    font-size: .65rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: .6rem;
  }

  .skill-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-bottom: .8rem;
  }

  .skill-tags { display: flex; flex-wrap: wrap; gap: .35rem; }

  .tag {
    font-family: var(--font-mono);
    font-size: .62rem;
    letter-spacing: .06em;
    padding: .28rem .65rem;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    transition: border-color .2s, color .2s;
  }
  .skill-card:hover .tag {
    border-color: var(--accent);
    color: var(--ink);
  }

  @media (max-width: 768px) {
    section { padding: 5rem 1.5rem; }
  }
</style>
