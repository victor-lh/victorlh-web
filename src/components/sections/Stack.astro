---
import Chip from '../ui/Chip.astro';

type Tone = 'accent-soft' | 'plain' | 'muted' | 'accent';

const skillCards: { category: string; name: string; tags: string[]; tone: Tone }[] = [
  {
    category: 'Backend',
    name: 'Lenguajes & Frameworks',
    tags: ['Java 17', 'Spring Boot', 'Spring Cloud', 'Kotlin', 'Node.js', 'Python', 'REST', 'SOAP'],
    tone: 'accent-soft',
  },
  {
    category: 'Arquitectura',
    name: 'Diseño de Sistemas',
    tags: ['Microservicios', 'Event-Driven', 'Hexagonal', 'Serverless', 'RabbitMQ', 'GCP Pub/Sub', 'API First', 'WebRTC'],
    tone: 'plain',
  },
  {
    category: 'Infraestructura',
    name: 'DevOps & Cloud',
    tags: ['Docker', 'Kubernetes', 'OpenShift', 'GCP', 'GKE', 'Jenkins', 'CI/CD', 'Git'],
    tone: 'plain',
  },
  {
    category: 'Datos',
    name: 'Bases de Datos',
    tags: ['PostgreSQL', 'Oracle DB', 'MongoDB', 'IBM DB2', 'SQL Server', 'Elasticsearch', 'Firebase'],
    tone: 'muted',
  },
  {
    category: 'Observabilidad & APIs',
    name: 'Monitoring & Seguridad',
    tags: ['Kibana / ELK', 'WSO2', 'Spring Security', 'Maven', 'OpenAPI', 'GraphQL'],
    tone: 'plain',
  },
  {
    category: 'Sectores',
    name: 'Experiencia en industria',
    tags: ['Fintech', 'Seguros', 'E-commerce', 'Mobile', 'Sector público', 'Retail'],
    tone: 'accent',
  },
];
---

<section id="skills" class="section">
  <div class="container">
    <h2 class="section-title reveal">Skills</h2>

    <div class="skills-bento">
      {
        skillCards.map((card) => (
          <article class:list={['skill-tile', `skill-tile--${card.tone}`, 'reveal']}>
            <header>
              <p class="skill-cat">{card.category}</p>
              <h3 class="skill-name">{card.name}</h3>
            </header>

            {card.tone === 'accent' ? (
              <ul class="skill-words">
                {card.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            ) : (
              <ul class="skill-tags">
                {card.tags.map((tag) => (
                  <li>
                    <Chip label={tag} />
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills-bento {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .skill-tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: 16rem;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border-radius: var(--radius-lg);
  }

  /* Asymmetric rhythm: 7/5, 5/7, 7/5 */
  .skill-tile:nth-child(1),
  .skill-tile:nth-child(4),
  .skill-tile:nth-child(5) {
    grid-column: span 7;
  }
  .skill-tile:nth-child(2),
  .skill-tile:nth-child(3),
  .skill-tile:nth-child(6) {
    grid-column: span 5;
  }

  .skill-tile--plain {
    background: var(--white);
    border: 1px solid var(--line);
  }
  .skill-tile--muted {
    background: var(--surface);
  }
  .skill-tile--accent-soft {
    background: var(--accent-soft);
  }
  .skill-tile--accent {
    background: var(--accent);
    color: var(--white);
  }

  .skill-cat {
    margin-bottom: .35rem;
    font-size: .875rem;
    color: var(--ink-soft);
  }
  .skill-tile--accent .skill-cat {
    color: color-mix(in srgb, var(--white) 78%, transparent);
  }

  .skill-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -.025em;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    list-style: none;
  }

  .skill-words {
    display: flex;
    flex-wrap: wrap;
    gap: .15rem 1.1rem;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -.02em;
  }

  @media (max-width: 1023px) {
    .skill-tile:nth-child(n) {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .skill-tile:nth-child(n) {
      grid-column: 1 / -1;
      min-height: 0;
    }
  }
</style>
