---
import { getCollection, type CollectionEntry } from 'astro:content';

const entries = await getCollection('experience');
const sorted = entries.sort((a, b) => a.data.order - b.data.order);

// Consecutive roles at the same company are shown as one group
const groups = sorted.reduce<{ company: string; roles: CollectionEntry<'experience'>[] }[]>(
  (acc, entry) => {
    const last = acc.at(-1);
    if (last && last.company === entry.data.company) last.roles.push(entry);
    else acc.push({ company: entry.data.company, roles: [entry] });
    return acc;
  },
  [],
);

const splitPeriod = (period: string) => period.split(/\s*[—–]\s*/);
---

<section id="experience" class="section">
  <div class="container exp-layout">
    <div class="exp-heading">
      <h2 class="section-title reveal">Experiencia</h2>
    </div>

    <ol class="exp-groups">
      {
        groups.map((group) => (
          <li class="exp-group reveal">
            <h3 class="exp-company">{group.company}</h3>

            <ol class="exp-roles">
              {group.roles.map((entry) => {
                const [start, end] = splitPeriod(entry.data.period);
                return (
                  <li class:list={['exp-role', entry.data.current && 'is-current']}>
                    <div class="exp-role-head">
                      <h4 class="exp-title">{entry.data.role}</h4>
                      <p class="exp-period">
                        {start}
                        {end && (
                          <>
                            {' - '}
                            <span class="exp-period-end">{end}</span>
                          </>
                        )}
                      </p>
                    </div>
                    {entry.data.sector && <p class="exp-sector">{entry.data.sector}</p>}
                    <p class="exp-desc">{entry.data.description}</p>
                    <ul class="exp-tags" aria-label="Tecnologías">
                      {entry.data.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  </li>
                );
              })}
            </ol>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .exp-layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2rem;
  }

  .exp-heading {
    grid-column: 1 / span 4;
  }
  .exp-heading .section-title {
    position: sticky;
    top: 6.5rem;
  }

  .exp-groups {
    grid-column: 5 / -1;
    list-style: none;
  }

  .exp-group {
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .exp-group:first-child {
    padding-top: .5rem;
    border-top: 0;
  }

  .exp-company {
    margin-bottom: 1.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
    line-height: 1.1;
    letter-spacing: -.03em;
  }

  /* Timeline */
  .exp-roles {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-left: 1.75rem;
    list-style: none;
  }
  .exp-roles::before {
    content: '';
    position: absolute;
    left: 5px;
    top: .6rem;
    bottom: .6rem;
    width: 1px;
    background: var(--line);
  }

  .exp-role {
    position: relative;
  }
  .exp-role::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem);
    top: .45rem;
    width: 11px;
    height: 11px;
    border: 1.5px solid var(--ink-soft);
    border-radius: 50%;
    background: var(--bg);
  }
  .exp-role.is-current::before {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .exp-role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .25rem 1.5rem;
  }

  .exp-title {
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.35;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: .8125rem;
    color: var(--ink-soft);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .is-current .exp-period-end {
    color: var(--accent);
    font-weight: 500;
  }

  .exp-sector {
    margin-top: .2rem;
    font-size: .9375rem;
    color: var(--ink-soft);
  }

  .exp-desc {
    max-width: 62ch;
    margin-top: .9rem;
    font-size: 1rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--ink) 82%, var(--bg));
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .3rem 1rem;
    margin-top: 1rem;
    list-style: none;
    font-family: var(--font-mono);
    font-size: .78rem;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .exp-heading,
    .exp-groups {
      grid-column: 1 / -1;
    }
    .exp-heading .section-title {
      position: static;
    }
  }
</style>
