---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.png';
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';

const pills = [
  'Java · Spring Boot',
  'Microservicios',
  'Kotlin · Node.js',
  'Kubernetes · GCP',
  'Event-Driven',
];

const stats = [
  { num: '10', label: 'Años de experiencia' },
  { num: '6', label: 'Empresas & proyectos' },
  // { num: '1M+', label: 'Usuarios en Roostfy' },
  { num: '5+', label: 'Sectores distintos' },
];
---

<section id="hero" class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-label intro" style="--i: 0">Backend Engineer · Madrid, ES</p>

        <h1 class="hero-name intro" style="--i: 1">
          <span>Víctor</span>
          <span>Latorre</span>
        </h1>

        <p class="hero-tagline intro" style="--i: 2">
          Especialista en arquitecturas de microservicios, sistemas distribuidos y modernización de
          plataformas críticas en el ecosistema Java/Spring.
        </p>

        <div class="hero-cta intro" style="--i: 3">
          <Button variant="solid" href="#experience" label="Ver trayectoria" />
          <Button variant="link" href="#contact" label="Hablemos" />
        </div>
      </div>

      <figure class="hero-portrait intro" style="--i: 2">
        <div class="portrait-frame">
          <Image
            src={avatar}
            alt="Ilustración de Víctor Latorre"
            width={avatar.width}
            height={avatar.height}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </figure>
    </div>

    <div class="hero-facts intro" style="--i: 4">
      <dl class="facts-stats">
        {
          stats.map((s) => (
            <div class="fact">
              <dt>{s.label}</dt>
              <dd>{s.num}</dd>
            </div>
          ))
        }
      </dl>

      <ul class="facts-pills" aria-label="Especialidades">
        {
          pills.map((p) => (
            <li>
              <Chip label={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 6.5rem 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }

  /* Label */
  .hero-label {
    font-family: var(--font-mono);
    font-size: .8125rem;
    color: var(--ink-soft);
  }

  /* Name */
  .hero-name {
    margin-block: 1.25rem 1.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: .92;
    letter-spacing: -.05em;
  }
  .hero-name span {
    display: block;
  }
  .hero-name span:last-child {
    color: var(--ink-soft);
  }

  /* Tagline */
  .hero-tagline {
    max-width: 42ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* CTA */
  .hero-cta {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* Portrait */
  .hero-portrait {
    position: relative;
    isolation: isolate;
    justify-self: end;
    width: 100%;
    max-width: 420px;
    margin-bottom: .75rem;
  }
  .hero-portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    transform: translate(.9rem, .9rem);
  }

  .portrait-frame {
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-lift);
  }
  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Facts */
  .hero-facts {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-block: 2rem;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .facts-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
  }

  .fact {
    display: flex;
    flex-direction: column-reverse;
  }
  .fact dd {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: -.04em;
    font-variant-numeric: tabular-nums;
  }
  .fact dt {
    margin-top: .5rem;
    font-size: .875rem;
    color: var(--ink-soft);
  }

  .facts-pills {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    list-style: none;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 5.5rem;
    }

    .hero-grid,
    .hero-facts {
      grid-template-columns: 1fr;
    }

    .hero-portrait {
      order: -1;
      justify-self: start;
      max-width: min(200px, 55vw);
      margin-bottom: 1rem;
    }
    .hero-portrait::before {
      transform: translate(.5rem, .5rem);
    }

    .hero-name {
      margin-block: 1rem 1.25rem;
    }
  }
</style>
