---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import avatar from '../assets/avatar.png';
import { site } from '../data/site';
import { lastUpdated } from '../data/last-updated';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const { title, description, canonicalUrl = Astro.url.href, noindex = false } = Astro.props;

const ogImage = new URL('/og-image.png', Astro.site).href;
const avatarImage = await getImage({ src: avatar, format: 'png', width: 400 });
const currentJob = (await getCollection('experience')).find((entry) => entry.data.current);

const websiteId = `${site.url}/#website`;
const personId = `${site.url}/#person`;

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: site.fullName,
  alternateName: site.alternateName,
  url: `${site.url}/`,
  inLanguage: 'es-ES',
  publisher: { '@id': personId },
};

const person = {
  '@type': 'Person',
  '@id': personId,
  name: site.fullName,
  jobTitle: site.jobTitle,
  description:
    'Backend Engineer especializado en microservicios, arquitecturas distribuidas y ecosistema Java/Spring.',
  url: site.url,
  image: new URL(avatarImage.src, Astro.site).href,
  email: site.email,
  sameAs: [site.linkedin, site.github],
  knowsAbout: [
    'Java',
    'Spring Boot',
    'Microservicios',
    'Arquitecturas distribuidas',
    'Event-Driven Architecture',
    'Kubernetes',
    'Google Cloud Platform',
    'Kotlin',
    'Node.js',
  ],
  ...(currentJob && {
    worksFor: { '@type': 'Organization', name: currentJob.data.company },
  }),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location.city,
    addressCountry: site.location.country,
  },
};

// ProfilePage only on indexable pages (the 404 keeps WebSite + Person)
const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${canonicalUrl}#profilepage`,
  url: canonicalUrl,
  name: title,
  inLanguage: 'es-ES',
  isPartOf: { '@id': websiteId },
  dateModified: lastUpdated.toISOString(),
  mainEntity: { '@id': personId },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': noindex ? [website, person] : [website, profilePage, person],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F1F2F4" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts (self-hosted via Astro Fonts; preload the above-the-fold families) -->
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    <noscript>
      <style>
        .reveal { opacity: 1; transform: none; }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal on scroll
      const reveals = document.querySelectorAll('.reveal');
      const obs = new IntersectionObserver(
        (entries) => {
          entries
            .filter((e) => e.isIntersecting)
            .forEach((e, i) => {
              setTimeout(() => e.target.classList.add('visible'), i * 80);
              obs.unobserve(e.target);
            });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );
      reveals.forEach((el) => obs.observe(el));
    </script>
    {
      import.meta.env.PROD && (
        <>
          <!-- Cloudflare Web Analytics -->
          <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon='{"token": "dbb87cf3e9c448b9ba0f7ed419889307"}'
          />
        </>
      )
    }
  </body>
</html>
